{
  "realm": "staff",
  "enabled": true,
  "accessTokenLifespan": 70,
  "groups": [{ "name": "staff" }, { "name": "away-admins" }],
  "users": [
    {
      "username": "alex.urban",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alex",
      "lastName": "Urban",
      "email": "alex.urban@example.com",
      "credentials": [{ "type": "password", "value": "@PASSWORD@", "temporary": false }],
      "groups": ["/staff", "/away-admins"]
    }
  ],
  "clients": [
    {
      "clientId": "away",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "@SECRET@",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["@BACK@"],
      "webOrigins": [],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
