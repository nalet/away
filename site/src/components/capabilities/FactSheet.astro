---
// one capability's fact sheet: where it stands for each kind of connection or for Away
// itself, its note, the expectations that name it, the figures of the screens that draw
// it, how it is built (the components that carry it, the work packages that deliver it,
// the decisions that govern it), and the rest of its area. the page
// /spec/capabilities/<part>/<key>/ is this; the map shows the same element beside its
// tiles, fetched from that page, so there is one fact sheet, not two.
import Figure from '../screens/Figure.astro';
import { load, STATUS, WHO, EXPECTED, partLink, expectationsLink } from '../../lib/model.mjs';
import { BASE } from '../../../site.mjs';

interface Props {
	cap: any;
}
const { cap } = Astro.props;
const m = load();
const area = m.areaByKey.get(cap.area);
const part = m.partByKey.get(cap.part);
const goal = m.goalByKey.get(area.goal);
const listed = (xs: string[]) => (xs.length < 2 ? xs.join('') : xs.slice(0, -1).join(', ') + ' and ' + xs.at(-1));
const sentence = (s: string) => s.charAt(0).toUpperCase() + s.slice(1) + '.';

const where = m.where.map((w: any) => ({ ...w, status: cap.status[w.key] }));
const stands = where.filter((w: any) => w.status !== '—');
// a capability about a session: the protocols it does not apply to are worth a word
const notMeant = stands.some((w: any) => w.session) ? where.filter((w: any) => w.session && w.status === '—') : [];
const expected = cap.expected.map((k: string) => m.expectationByKey.get(k)).filter(Boolean);
const siblings = m.capabilities.filter((c: any) => c.area === cap.area);
// the figures of the screens that draw it; one that a person or an administrator would
// see in the first release, and that no figure draws, says so
const figures: any[] = cap.figures ?? [];
const toSee = ['person', 'admin'].includes(cap.who) && ['built', 'partial', 'v1'].includes(cap.state);
const WIDTH: Record<string, number> = { computer: 300, phone: 104, 'phone-side': 230 };
// how it is built: only a capability of the first release has components and packages
const carriedBy: any[] = cap.carriedBy ?? [];
const builtIn: any[] = [...(cap.builtIn ?? [])].sort((a, b) => a.pack.no - b.pack.no);
const decidedBy: any[] = cap.decidedBy ?? [];
const wayLabel = (k: string) => (k === 'away' ? 'Away itself' : (m.where.find((w: any) => w.key === k)?.label ?? k));
---

<div class="capsheet" data-factsheet data-key={cap.key}>
	<p class="capsheet-trail not-content">
		<a href={`${BASE}/spec/capabilities/map/?focus=${cap.key}`}>capability map</a>
		<span aria-hidden="true">/</span>
		<a href={partLink(m, cap.part)}>{part.label}</a>
		<span aria-hidden="true">/</span>
		<a href={partLink(m, cap.part, area.area)}>{area.area}</a>
	</p>
	<p class="capsheet-meta not-content">
		<code>{cap.key}</code>
		<span>{WHO[cap.who]}</span>
		<span>
			for the goal <a href={goal.url}>{goal.goal}</a>
		</span>
	</p>

	<ul class="capsheet-faces not-content" aria-label="where it stands">
		{
			stands.map((w: any) => (
				<li data-tone={STATUS[w.status].tone}>
					<span class="capsheet-face">{w.session ? `a session over ${w.label}` : 'Away itself'}</span>
					<span class="capsheet-status">{STATUS[w.status].name}</span>
				</li>
			))
		}
	</ul>
	{notMeant.length > 0 && <p class="capsheet-quiet">Does not apply to a session over {listed(notMeant.map((w: any) => w.label))}.</p>}
	{cap.note && <p class="capsheet-note">{sentence(cap.note)}</p>}

	<h2 id="expected">Expected</h2>
	{
		expected.length > 0 ? (
			<ul class="capsheet-expected">
				{expected.map((e: any) => (
					<li>
						<a href={expectationsLink(m, e.goal)}>{e.expectation}</a>
						<span class="capsheet-chip" data-tone={EXPECTED[e.state] ?? 'neutral'}>
							{e.state}
						</span>
					</li>
				))}
			</ul>
		) : (
			<p>No expectation names it.</p>
		)
	}

	{(figures.length > 0 || toSee) && <h2 id="drawn">Drawn</h2>}
	{
		figures.length > 0 ? (
			<div class="figs not-content">
				{figures.map((f: any) => (
					<Figure screen={f} width={WIDTH[f.size] ?? 300} />
				))}
			</div>
		) : (
			toSee && <p>No figure of the screens shows it.</p>
		)
	}

	{(carriedBy.length > 0 || builtIn.length > 0) && <h2 id="built">Built</h2>}
	{
		carriedBy.length > 0 && (
			<p>
				Carried by {listed(carriedBy.map((c: any) => c.name))} (<a href={`${BASE}/spec/architecture/carried/`}>where each capability is carried</a>).
			</p>
		)
	}
	{
		builtIn.length > 0 && (
			<ul class="capsheet-expected">
				{builtIn.map((b: any) => (
					<li>
						<a href={b.pack.url}>
							Work package {b.pack.no}: {b.pack.package}
						</a>
						{!b.all && (
							<span class="capsheet-chip" data-tone="neutral">
								{b.ways.map(wayLabel).join(', ')}
							</span>
						)}
						{b.note && <span class="capsheet-quiet">{b.note}</span>}
					</li>
				))}
			</ul>
		)
	}
	{
		decidedBy.length > 0 && (
			<p class="capsheet-quiet">
				Governed by{' '}
				{decidedBy.map((d: any, i: number) => (
					<>
						{i > 0 && ', '}
						<a href={d.url}>ADR-{d.adr}</a>
					</>
				))}
				.
			</p>
		)
	}

	<h2 id="area">{area.area}</h2>
	<p class="capsheet-quiet">{area.intro}</p>
	<ul class="capsheet-siblings">
		{
			siblings.map((c: any) => (
				<li>
					<a href={c.url} data-key={c.key} aria-current={c.key === cap.key ? 'page' : undefined}>
						{c.capability}
					</a>
					<span>{STATUS[c.state].name}</span>
				</li>
			))
		}
	</ul>
</div>
