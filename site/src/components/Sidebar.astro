---
// the side navigation: the current section's pages. below 72rem, where the top bar
// has no room for the sections, the area's sections lead the list, as in the design
// system's menu.
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { BASE } from '../../site.mjs';

const { hasSidebar } = Astro.locals.starlightRoute;
const { isPageWithTopic } = Astro.locals.starlightSidebarTopics;
const area = Astro.url.pathname.slice(BASE.length).startsWith('/spec/') ? '/spec/' : '/docs/';
// a section's address comes with or without the site's base, by how the page is served:
// take it off to tell the area, and put it on for the link.
const bare = (link: string) => (link.startsWith(BASE + '/') ? link.slice(BASE.length) : link);
const topics = Astro.locals.starlightSidebarTopics.topics
	.map((topic) => ({ ...topic, link: bare(topic.link) }))
	.filter((topic) => topic.link.startsWith(area));
---

{
	hasSidebar && isPageWithTopic && (
		<ul class="aw-topics" aria-label="sections">
			{topics.map((topic) => (
				<li>
					<a href={BASE + topic.link} aria-current={topic.isCurrent ? 'true' : undefined}>
						{topic.label}
					</a>
				</li>
			))}
		</ul>
	)
}
<Default><slot /></Default>
