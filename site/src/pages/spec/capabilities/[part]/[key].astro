---
// /spec/capabilities/<part>/<key>/: a capability's fact sheet, one for each row of
// spec/capabilities/capabilities.csv (see src/lib/model.mjs).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import FactSheet from '../../../../components/capabilities/FactSheet.astro';
import { load } from '../../../../lib/model.mjs';
import { GITHUB, BRANCH } from '../../../../../site.mjs';
import '../../../../styles/maps.css';

export function getStaticPaths() {
	const m = load();
	return (m?.capabilities ?? []).map((cap: any) => ({ params: { part: cap.part, key: cap.key }, props: { key: cap.key } }));
}

const m = load();
const cap = m.capByKey.get(Astro.props.key);
const area = m.areaByKey.get(cap.area);
const drawn = (cap.figures ?? []).length > 0 || (['person', 'admin'].includes(cap.who) && ['built', 'partial', 'v1'].includes(cap.state));
const headings = [['expected', 'Expected'], ...(drawn ? [['drawn', 'Drawn']] : []), ['area', area.area]].map(([slug, text]) => ({
	depth: 2,
	slug,
	text,
}));
---

<StarlightPage
	frontmatter={{
		title: cap.capability,
		description: `${cap.capability}: where it stands for a session over RDP, VNC or SSH, or for Away itself, and the expectations that name it.`,
		editUrl: `${GITHUB}/edit/${BRANCH}/spec/capabilities/capabilities.csv`,
	}}
	headings={headings}
>
	<FactSheet cap={cap} />
</StarlightPage>
